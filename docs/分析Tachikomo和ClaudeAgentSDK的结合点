核心接口设计
typescript
// Worker 后端抽象接口
interface IWorkerBackend {
  readonly provider: string;
  
  // 执行任务（统一的输入输出）
  execute(
    task: WorkerTask,
    tools: Tool[],
    options: WorkerExecutionOptions
  ): AsyncIterable<WorkerMessage>;
  
  // 能力查询
  getCapabilities(): WorkerCapability[];
  
  // 中断执行
  interrupt(): Promise<void>;
}
// 后端工厂 - 根据 provider 自动选择
function createWorkerBackend(config: WorkerConfig): IWorkerBackend {
  if (config.provider === 'anthropic' && config.useAgentSDK !== false) {
    // Claude 模型 → 使用 Agent SDK
    return new ClaudeAgentSDKBackend(config);
  }
  // 其他模型 → 使用自研方案
  return new GenericAgentBackend(config);
}
两种后端的实现差异
Claude Agent SDK 后端
typescript
class ClaudeAgentSDKBackend implements IWorkerBackend {
  provider = 'anthropic';
  async *execute(task, tools, options) {
    const query = await import('@anthropic-ai/claude-agent-sdk').then(m => m.query);
    
    const result = query({
      prompt: task.objective,
      options: {
        cwd: options.workDir,
        permissionMode: 'bypassPermissions',
        mcpServers: this.convertToMCPServers(tools),
        // Tachikoma 的工具转换为 MCP Tools
        ...this.mapTachikomaOptions(options),
      },
    });
    // 转换输出为统一格式
    for await (const msg of result) {
      yield this.transformMessage(msg);
    }
  }
}
自研通用后端
typescript
class GenericAgentBackend implements IWorkerBackend {
  constructor(private llmClient: LLMClient) {}
  async *execute(task, tools, options) {
    const context = new ContextManager(options);
    let done = false;
    while (!done) {
      // 1. 调用 LLM
      const response = await this.llmClient.chat({
        messages: context.getMessages(),
        tools: tools.map(this.convertToLLMTool),
      });
      yield { type: 'thinking', content: response.content };
      // 2. 处理工具调用
      if (response.toolCalls?.length) {
        for (const call of response.toolCalls) {
          const result = await this.executeTool(call, options);
          yield { type: 'tool_result', tool: call.name, result };
          context.addToolResult(call, result);
        }
      } else {
        done = true;
      }
      // 3. 检查上下文大小，必要时压缩
      if (context.shouldCompact()) {
        await context.compact();
      }
    }
  }
}
