2. 融合 MCP 扩展机制 ⭐⭐⭐
Claude Agent SDK 原生支持 MCP，你可以：

typescript
import { createSdkMcpServer, tool } from '@anthropic-ai/claude-agent-sdk';
// 创建 Tachikoma 内部工具作为 MCP Server
const tachikomaMcp = createSdkMcpServer({
  name: 'tachikoma-orchestrator',
  tools: [
    tool('request_approval', '向 Orchestrator 请求审批', { ... }, async (args) => {
      // Worker 调用此工具向 Orchestrator 请求审批
      await sessionManager.writePendingApproval(workerId, args);
      return await waitForApprovalResponse();
    }),
    
    tool('report_progress', '报告任务进度', { ... }, async (args) => {
      await sessionManager.writeWorkerStatus(workerId, args);
    }),
    
    tool('get_shared_context', '获取共享上下文', { ... }, async () => {
      return await sessionManager.readSharedContext();
    }),
  ],
});
// Worker 使用时注入这个 MCP
query({
  prompt: subtask.objective,
  options: {
    mcpServers: [tachikomaMcp],
  }
});
