### 8.2 实现 /skill 命令

```typescript
// packages/core/src/skills/skill-learning.ts

export interface SkillLearningInput {
  trajectory: ThinkingRecord[];   // 执行轨迹
  feedback?: {                     // 验证反馈
    testsPassed: boolean;
    testOutput: string;
    typeCheckPassed: boolean;
  };
  userInstructions?: string;       // 用户指导
}

export async function learnSkillFromTrajectory(
  input: SkillLearningInput
): Promise<LearnedSkill> {
  // 1. Reflection 阶段：使用 LLM 分析轨迹
  const reflection = await reflect(input.trajectory, input.feedback);
  
  // 2. Creation 阶段：生成 SKILL.md
  const skillContent = await generateSkill(reflection, input.userInstructions);
  
  // 3. 写入 .skills 目录
  await writeSkillFile(skillContent);
  
  // 4. 刷新 skills 内存块
  await refreshSkillsBlock();
  
  return skillContent;
}

// CLI 命令
// tachikoma skill --learn "数据库迁移模式"
```

### 8.3 实现 /remember 命令

```typescript
// packages/core/src/conversation/commands/remember.ts

export async function handleRememberCommand(
  content: string,
  conversationContext: ConversationContext
): Promise<void> {
  // 1. 分析对话上下文，确定要记住什么
  const memoryToStore = await analyzeWhatToRemember(
    content,
    conversationContext
