# Credentials are read by pi's ModelRuntime. Tachikoma never accepts API keys as CLI flags.
# Configure only the providers you use.
# Custom OpenAI-compatible gateways live in ~/.tachikoma/models.json (README: "Custom models
# and endpoints"); its apiKey field supports "$OPENAI_API_KEY"-style env interpolation.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional product defaults.
TACHIKOMA_DATA_DIR=
TACHIKOMA_PROVIDER=anthropic
TACHIKOMA_MODEL=claude-sonnet-5
TACHIKOMA_USER_ID=

# Live tests are always opt-in. Normal tests ignore credentials, even when this is unset.
TACHIKOMA_RUN_LIVE_TESTS=0
