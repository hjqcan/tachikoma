{
  "name": "tachikoma",
  "version": "0.2.0",
  "description": "A conversation-first chatbot runtime built on pi-mono.",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/core",
    "packages/cli"
  ],
  "scripts": {
    "build": "bun run build:core && bun run build:cli",
    "build:core": "bun run --cwd packages/core build",
    "build:cli": "bun run --cwd packages/cli build",
    "clean": "bun run --cwd packages/core clean && bun run --cwd packages/cli clean",
    "dev": "bun run packages/cli/src/cli.ts",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "bun run --cwd packages/core typecheck && bun run --cwd packages/cli typecheck",
    "test": "bun test --preload ./packages/core/tests/offline-guard.ts packages/core/tests packages/cli/tests --path-ignore-patterns '**/tests/live/**' --path-ignore-patterns '**/tests/package/**'",
    "test:package": "bun test --preload ./packages/core/tests/offline-guard.ts packages/cli/tests/package",
    "test:pack": "bash ./scripts/verify-packed-packages.sh",
    "test:coverage": "bun run test --coverage",
    "test:live": "bun test packages/core/tests/live",
    "audit": "bun audit",
    "verify": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build && bun run test:package && bun run test:pack && bun run audit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.3.14",
    "@types/node": "26.2.0",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hjqcan/tachikoma.git"
  },
  "keywords": [
    "ai",
    "chatbot",
    "chat",
    "typescript",
    "bun",
    "pi-mono"
  ]
}
