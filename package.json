{
  "name": "tachikoma",
  "version": "0.1.0",
  "description": "以 pi-mono 为执行内核的对话优先编码助手",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "skills",
    "servers"
  ],
  "scripts": {
    "dev": "bun run --cwd packages/gateway dev",
    "build": "bun run build:core && bun run build:gateway",
    "build:core": "bun run --cwd packages/core build",
    "build:gateway": "bun run --cwd packages/gateway build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "typecheck": "tsc -b && tsc -p packages/core/tsconfig.bin.json && tsc -p packages/core/tsconfig.test.json && tsc -p packages/gateway/tsconfig.test.json && bun run --cwd servers typecheck",
    "test": "bun test packages --path-ignore-patterns '**/dist/**'",
    "test:coverage": "bun test packages --coverage --path-ignore-patterns '**/dist/**'",
    "clean": "rm -rf packages/*/dist node_modules/.cache"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.3.14",
    "@types/node": "22.20.1",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "typescript-language-server": "5.3.0"
  },
  "overrides": {
    "body-parser": "2.3.0",
    "fast-uri": "3.1.5",
    "flatted": "3.4.4",
    "path-to-regexp": "8.4.2",
    "qs": "6.15.3",
    "uuid": "11.1.1"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/tachikoma.git"
  },
  "keywords": [
    "ai",
    "agent",
    "multi-agent-system",
    "orchestrator",
    "typescript",
    "bun"
  ]
}
