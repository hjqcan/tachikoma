{
  "name": "@tachikoma/agentops",
  "version": "0.1.0",
  "description": "Tachikoma AgentOps - 可观测性、追踪、指标、评估",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tracing": {
      "import": "./dist/tracing/index.js",
      "types": "./dist/tracing/index.d.ts"
    },
    "./logging": {
      "import": "./dist/logging/index.js",
      "types": "./dist/logging/index.d.ts"
    },
    "./metrics": {
      "import": "./dist/metrics/index.js",
      "types": "./dist/metrics/index.d.ts"
    },
    "./eval": {
      "import": "./dist/eval/index.js",
      "types": "./dist/eval/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun build ./src/index.ts --outdir ./dist --target bun",
    "build:types": "tsc -p tsconfig.build.json",
    "dev": "bun --watch src/server/server.ts",
    "dev:web": "vite",
    "build:web": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/bun": "latest",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "autoprefixer": "^10.4.24",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.0",
    "vite": "^7.3.1"
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "tachikoma",
    "agentops",
    "observability",
    "tracing"
  ],
  "license": "MIT"
}
