{
  "name": "@hjqcan/tachikoma-cli",
  "version": "0.2.0",
  "description": "The Tachikoma conversation-first CLI.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tachikoma": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "bun src/cli.ts",
    "test": "bun test tests --path-ignore-patterns 'tests/package/**'",
    "test:package": "bun test tests/package",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@hjqcan/tachikoma-core": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "6.0.3"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "keywords": [
    "tachikoma",
    "chatbot",
    "cli",
    "pi-mono"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hjqcan/tachikoma.git",
    "directory": "packages/cli"
  }
}
