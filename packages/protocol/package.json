{
  "name": "@hjqcan/tachikoma-protocol",
  "version": "0.2.0",
  "description": "The Tachikoma wire contract: zod schemas for events, frames, and RPC.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "bun test tests",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "zod": "4.2.1"
  },
  "devDependencies": {
    "@hjqcan/tachikoma-core": "workspace:*",
    "@types/bun": "1.3.14",
    "typescript": "6.0.3"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "keywords": [
    "tachikoma",
    "protocol",
    "zod"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hjqcan/tachikoma.git",
    "directory": "packages/protocol"
  },
  "publishConfig": {
    "access": "public"
  }
}
