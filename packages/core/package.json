{
  "name": "@tachikoma/core",
  "version": "0.1.2",
  "description": "Tachikoma 核心库 - 智能体、上下文、工具、沙盒、MCP 集成",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./agents": {
      "import": "./dist/agents/index.js",
      "types": "./dist/agents/index.d.ts"
    },
    "./tools": {
      "import": "./dist/tools/index.js",
      "types": "./dist/tools/index.d.ts"
    },
    "./sandbox": {
      "import": "./dist/sandbox/index.js",
      "types": "./dist/sandbox/index.d.ts"
    },
    "./mcp": {
      "import": "./dist/mcp/index.js",
      "types": "./dist/mcp/index.d.ts"
    },
    "./mcp/sandbox-ipc": {
      "import": "./dist/mcp/sandbox-ipc.js",
      "types": "./dist/mcp/sandbox-ipc.d.ts"
    },
    "./memory": {
      "import": "./dist/memory/index.js",
      "types": "./dist/memory/index.d.ts"
    },
    "./internal/prompt": {
      "import": "./dist/internal/prompt/index.js",
      "types": "./dist/internal/prompt/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun build ./src/index.ts --outdir ./dist --target bun --external playwright --external electron --external '@earendil-works/pi-*'",
    "build:types": "tsc -p tsconfig.build.json",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.bin.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.0.1",
    "@ai-sdk/anthropic": "4.0.37",
    "@ai-sdk/openai": "4.0.37",
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@qdrant/js-client-rest": "1.19.0",
    "ai": "7.0.59",
    "goodmemory": "0.7.2",
    "ioredis": "6.0.0",
    "level": "10.0.0",
    "vscode-jsonrpc": "9.0.1",
    "vscode-languageserver-types": "3.18.0",
    "zod": "4.4.3",
    "zod-to-json-schema": "3.25.2"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.227",
    "@anthropic-ai/sdk": "0.116.0",
    "@openai/agents": "0.14.3",
    "openai": "7.4.0",
    "pg": "8.23.0",
    "playwright": "1.62.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "6.0.3"
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "tachikoma",
    "core",
    "agent",
    "ai"
  ],
  "license": "MIT"
}
