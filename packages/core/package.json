{
  "name": "@tachikoma/core",
  "version": "0.1.2",
  "description": "Tachikoma 核心库 - 智能体、上下文、工具、沙盒、MCP 集成",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./agents": {
      "import": "./dist/agents/index.js",
      "types": "./dist/agents/index.d.ts"
    },
    "./tools": {
      "import": "./dist/tools/index.js",
      "types": "./dist/tools/index.d.ts"
    },
    "./tools/browser": {
      "import": "./dist/tools/browser.js",
      "types": "./dist/tools/browser.d.ts"
    },
    "./sandbox": {
      "import": "./dist/sandbox/index.js",
      "types": "./dist/sandbox/index.d.ts"
    },
    "./mcp": {
      "import": "./dist/mcp/index.js",
      "types": "./dist/mcp/index.d.ts"
    },
    "./memory": {
      "import": "./dist/memory/index.js",
      "types": "./dist/memory/index.d.ts"
    },
    "./internal/prompt": {
      "import": "./dist/internal/prompt/index.js",
      "types": "./dist/internal/prompt/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun build ./src/index.ts --outdir ./dist --target bun --external playwright --external electron",
    "build:types": "tsc -p tsconfig.build.json",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.0-beta.96",
    "@ai-sdk/openai": "^3.0.0-beta.110",
    "@modelcontextprotocol/sdk": "^1.24.3",
    "@qdrant/js-client-rest": "^1.16.2",
    "@types/uuid": "^11.0.0",
    "ai": "^6.0.0-beta.165",
    "ioredis": "^5.8.2",
    "json-schema-to-zod": "^2.7.0",
    "level": "^10.0.0",
    "uuid": "^13.0.0",
    "vscode-jsonrpc": "^8.2.0",
    "vscode-languageserver-types": "^3.17.5",
    "zod": "^4.2.1",
    "zod-to-json-schema": "^3.25.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "tachikoma",
    "core",
    "agent",
    "ai"
  ],
  "license": "MIT"
}
