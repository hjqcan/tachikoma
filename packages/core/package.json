{
  "name": "@hjqcan/tachikoma-core",
  "version": "0.2.0",
  "description": "Chat-only Tachikoma runtime built on pi AgentSession.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "bun run clean && tsc -p tsconfig.build.json && bun build ./src/index.ts --outdir ./dist --target bun --external '@earendil-works/pi-*' --external goodmemory --external 'goodmemory/*'",
    "build:types": "bun run clean && tsc -p tsconfig.build.json",
    "dev": "bun --watch src/index.ts",
    "test": "bun test --preload ./tests/offline-guard.ts ./tests --path-ignore-patterns 'tests/live/**'",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "clean": "rm -rf ./dist && rm -f ./tsconfig.tsbuildinfo ./tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "goodmemory": "0.7.4"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "6.0.3"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "tachikoma",
    "chatbot",
    "pi-mono"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hjqcan/tachikoma.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
