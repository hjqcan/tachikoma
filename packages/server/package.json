{
  "name": "@hjqcan/tachikoma-server",
  "version": "0.2.1",
  "description": "The Tachikoma local sidecar: HTTP RPC + WS event frames over a WAL.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tachikoma-engined": "./dist/engined.js",
    "tachikoma-acp": "./dist/acp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run clean && tsc -p tsconfig.build.json",
    "build:bin": "bun build --compile --minify src/engined.ts --outfile dist/tachikoma-engined",
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "bun src/engined.ts",
    "test": "bun test tests",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@hjqcan/tachikoma-core": "workspace:*",
    "@hjqcan/tachikoma-protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "6.0.3"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "keywords": [
    "tachikoma",
    "server",
    "sidecar"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hjqcan/tachikoma.git",
    "directory": "packages/server"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/hjqcan/tachikoma#readme",
  "bugs": {
    "url": "https://github.com/hjqcan/tachikoma/issues"
  }
}
