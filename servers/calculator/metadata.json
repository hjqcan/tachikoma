{
  "name": "calculator",
  "description": "Simple calculator MCP server for demonstration and testing",
  "version": "1.0.0",
  "tools": [
    {
      "name": "add",
      "description": "Add two numbers together",
      "inputSchema": {
        "type": "object",
        "properties": {
          "a": { "type": "number", "description": "First number" },
          "b": { "type": "number", "description": "Second number" }
        },
        "required": ["a", "b"]
      }
    },
    {
      "name": "multiply",
      "description": "Multiply two numbers",
      "inputSchema": {
        "type": "object",
        "properties": {
          "a": { "type": "number", "description": "First factor" },
          "b": { "type": "number", "description": "Second factor" }
        },
        "required": ["a", "b"]
      }
    },
    {
      "name": "divide",
      "description": "Divide two numbers",
      "inputSchema": {
        "type": "object",
        "properties": {
          "dividend": { "type": "number", "description": "Number to divide" },
          "divisor": { "type": "number", "description": "Number to divide by (non-zero)" }
        },
        "required": ["dividend", "divisor"]
      }
    }
  ]
}
